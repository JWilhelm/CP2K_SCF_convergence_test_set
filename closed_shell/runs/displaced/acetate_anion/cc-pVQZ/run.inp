&GLOBAL
  PROJECT run
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ccGTO_YE
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE -1
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 12
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 0.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 15.28463800 0.00000000 0.00000000
      B 0.00000000 14.88843700 0.00000000
      C 0.00000000 0.00000000 13.76349400
    &END CELL
    &COORD
      C      7.16855797     7.74111286     6.90283914
      O      7.37282236     8.80836419     6.86649535
      O      5.99560372     7.20093505     6.88873318
      C      8.29481188     6.57870267     6.80390878
      H      9.30350635     7.02950194     6.87597557
      H      8.26949909     6.04493159     7.75965140
      H      8.22010817     6.03864097     6.01818899
    &END COORD
    &KIND C
      BASIS_SET cc-pVQZ-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET cc-pVQZ-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET cc-pVQZ-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
