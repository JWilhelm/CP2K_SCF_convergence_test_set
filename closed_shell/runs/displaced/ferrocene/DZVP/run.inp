&GLOBAL
  PROJECT run
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ccGTO_YE
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 16
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 0.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 16.15428208 0.00000000 0.00000000
      B 0.00000000 16.36807068 0.00000000
      C 0.00000000 0.00000000 15.32000000
    &END CELL
    &COORD
      Fe     7.86746050     8.27151369     7.62683501
      C      9.12335039     8.13961332     9.28586686
      H     10.11070825     8.17926110     9.25752800
      C      8.26031268     9.33264518     9.37259696
      H      8.61900211    10.35248264     9.35379398
      C      6.93903099     8.84125243     9.31527902
      H      6.03342312     9.61447569     9.28197758
      C      6.90715651     7.46529021     9.31340986
      H      6.04149256     6.79169916     9.35890274
      C      8.25953404     7.07232476     9.35593345
      H      8.53259119     5.98794221     9.37051389
      C      9.00941502     8.16196404     5.93712867
      H     10.17366727     8.12568308     5.98934745
      C      8.21911796     9.42114040     6.02217711
      H      8.48199547    10.34362105     6.03132925
      C      6.88725591     8.81891186     6.00241968
      H      5.95579011     9.61957196     6.02365531
      C      6.86789456     7.50714426     6.08335752
      H      5.99362581     6.85640619     6.07658189
      C      8.16097916     6.99876885     6.02835849
      H      8.62357510     5.96215091     6.06953756
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q16
      POTENTIAL GTH-PBE-q16
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
