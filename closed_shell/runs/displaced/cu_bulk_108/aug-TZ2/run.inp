    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 128
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
