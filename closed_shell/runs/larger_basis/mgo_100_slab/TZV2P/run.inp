&GLOBAL
  PROJECT run
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ccGTO_YE
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 61
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 0.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 8.42400000 0.00000000 0.00000000
      B 0.00000000 8.42400000 0.00000000
      C 0.00000000 0.00000000 21.31800000
    &END CELL
