&GLOBAL
  PROJECT run
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ccGTO_YE
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 18
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 0.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 17.33812400 0.00000000 0.00000000
      B 0.00000000 22.97281320 0.00000000
      C 0.00000000 0.00000000 12.00000000
    &END CELL
    &COORD
      O      7.20273040    12.49857590     6.00000000
      C      8.04091560    13.40067440     6.00000000
      N      9.38957130    13.17467540     6.00000000
      C     10.30579100    14.19168300     6.00000000
      C      9.94596560    15.49258290     6.00000000
      C      8.54046150    15.84856150     6.00000000
      N      7.69133900    14.72604990     6.00000000
      O      8.07183910    16.97281320     6.00000000
      H     10.67941240    16.28027080     6.00000000
      H      9.69231350    12.19258860     6.00000000
      H      6.69903520    14.91879160     6.00000000
      H     11.33812400    13.87474830     6.00000000
      O     10.13539360    10.47423730     6.00000000
      C      9.29720840     9.57213880     6.00000000
      N      7.94855270     9.79813780     6.00000000
      C      7.03233300     8.78113020     6.00000000
      C      7.39215840     7.48023030     6.00000000
      C      8.79766250     7.12425170     6.00000000
      N      9.64678500     8.24676330     6.00000000
      O      9.26628490     6.00000000     6.00000000
      H      6.65871160     6.69254240     6.00000000
      H      7.64581050    10.78022460     6.00000000
      H     10.63908880     8.05402160     6.00000000
      H      6.00000000     9.09806490     6.00000000
    &END COORD
    &KIND C
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND N
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
