&GLOBAL
  PROJECT run
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    BASIS_SET_FILE_NAME BASIS_ccGRB_UZH
    BASIS_SET_FILE_NAME BASIS_ccGTO_YE
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      ADDED_MOS 16
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      IGNORE_CONVERGENCE_FAILURE
      CHOLESKY OFF
      EPS_EIGVAL 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 0.5
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 16.15428208 0.00000000 0.00000000
      B 0.00000000 16.36807068 0.00000000
      C 0.00000000 0.00000000 15.32000000
    &END CELL
    &COORD
      Fe     7.85785143     8.18403534     7.66000000
      C      9.07428208     8.18403534     9.32000000
      H     10.15428208     8.18403534     9.32000000
      C      8.23374917     9.34092964     9.32000000
      H      8.56748753    10.36807068     9.32000000
      C      6.87373835     8.89903534     9.32000000
      H      6.00000000     9.53384341     9.32000000
      C      6.87373835     7.46903534     9.32000000
      H      6.00000000     6.83422727     9.32000000
      C      8.23374917     7.02714104     9.32000000
      H      8.56748753     6.00000000     9.32000000
      C      9.07428208     8.18403534     6.00000000
      H     10.15428208     8.18403534     6.00000000
      C      8.23374917     9.34092964     6.00000000
      H      8.56748753    10.36807068     6.00000000
      C      6.87373835     8.89903534     6.00000000
      H      6.00000000     9.53384341     6.00000000
      C      6.87373835     7.46903534     6.00000000
      H      6.00000000     6.83422727     6.00000000
      C      8.23374917     7.02714104     6.00000000
      H      8.56748753     6.00000000     6.00000000
    &END COORD
    &KIND C
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Fe
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q16
      POTENTIAL GTH-PBE-q16
    &END KIND
    &KIND H
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
